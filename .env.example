# Easiest: run ./setup.sh, which asks a few questions and writes .env for you (docs/dev/19-setup.md).
# Or copy this file to .env and fill it in. Never commit the .env file.

ENV=dev

# Public address of this server, no trailing slash. The MCP server only accepts requests
# for this host; leave empty for local use only.
PUBLIC_URL=https://chilli.example.com

# Database password in docker compose
POSTGRES_PASSWORD=

# Token the iOS Shortcut sends in a header (a long random string, e.g. `openssl rand -hex 32`)
CAPTURE_TOKEN=

# Secret for the MCP server (`openssl rand -hex 32`)
MCP_SECRET=

# Language in which the model writes titles, summaries, tags and rating reasons
# (ISO 639-1 code: en, pl, de, fr...). Transcribed text always stays in its original language.
CONTENT_LANGUAGE=en
# How the prompts and the MCP instructions name you; empty = "the owner".
OWNER_NAME=

# --- Model (docs/dev/17-llm-provider.md) -----------------------------------------------------
# LLM_PROVIDER: anthropic (Claude) | openai (any OpenAI-compatible API).
# LLM_MODEL: model for links and ratings; also for screenshots unless LLM_VISION_MODEL is set.
# The screenshot model must accept images.
#
# Example 1, Claude (default). Empty LLM_MODEL = claude-sonnet-5-5.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_VISION_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
#
# Example 2, OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
#
# Example 3, Ollama (local, no key). From inside docker compose use the host's address,
# e.g. http://host.docker.internal:11434/v1, or http://ollama:11434/v1 for an `ollama` service.
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5vl:7b
# LLM_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# Other OpenAI-compatible servers work the same way with their LLM_BASE_URL, e.g.
# OpenRouter https://openrouter.ai/api/v1, Gemini https://generativelanguage.googleapis.com/v1beta/openai/,
# LM Studio http://host.docker.internal:1234/v1.

# Older names, still supported: with LLM_API_KEY / LLM_MODEL empty, provider anthropic uses these.
ANTHROPIC_API_KEY=
VISION_MODEL=
# How hard Claude should "think" on a screenshot: low | medium | high (Anthropic only)
VISION_EFFORT=low

# Local embedding model (384 dimensions)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
